# Build context for Dockerfile. Anything listed here never reaches the image (or the
# BuildKit context upload). Keep this list in sync when adding top-level directories.

# VCS / editor / agent metadata
.git
.gitignore
.gitattributes
.github
.claude
.vscode
.idea

# Local environments and caches
.venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
*.egg-info
dist
build

# Tests and fixtures are not needed at runtime (the sample sequence is hard-coded in
# app/api/samples.py; the signal sample lives in app/samples/signal and IS shipped).
tests

# The web UI has its own image (frontend/Dockerfile); keep node_modules out of this context.
frontend

# The DirectRM worker has its own image and build context (worker/Dockerfile, py3.10,
# 43 MB of weights); the subset/helper tools and the design docs are not runtime code.
worker
tools
docs

# Deployment tooling (Caddy, compose, CI) and dev scripts are used outside the image;
# the api container entrypoint is the one file of deploy/ that ships (Dockerfile).
deploy
!deploy/api-entrypoint.py
docker-compose*.yml
Dockerfile
.dockerignore
Makefile
scripts

# Secrets / local config
.env
.env.*
!.env.example

# Docs: only README.md (referenced by pyproject `readme`) is needed. Root-level *.md
# only; app/predictors/multirm/vendor/{LICENSE,UPSTREAM.md} stay in the image.
*.md
!README.md

# Notebooks, scratch data, logs
*.ipynb
**/.ipynb_checkpoints
notebooks
scratch
data
*.log
.DS_Store
!app/samples/signal/README.md
