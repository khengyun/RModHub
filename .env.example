# RModHub configuration. Copy to `.env` (git-ignored) and adjust.
# Docker Compose reads this file for ${VAR} interpolation; the application reads the
# RMODHUB_* variables via pydantic-settings (app/config.py). The worker reads the same
# names.

# ---------------------------------------------------------------------------
# Application (prefix RMODHUB_)
# ---------------------------------------------------------------------------

# Model back-end: "multirm" (real model, loads torch) or "stub" (deterministic fake,
# for API development / HTTP-layer tests without torch).
RMODHUB_PREDICTOR=multirm

# Maximum accepted input length in nucleotides for POST /api/predict/sequence.
RMODHUB_MAX_SEQUENCE_NT=10000

# Run one dummy inference at startup so the first real request is not slower.
RMODHUB_WARMUP=true

# Uvicorn / application log level: critical, error, warning, info, debug.
RMODHUB_LOG_LEVEL=info

# torch intra-op threads for inference (torch.set_num_threads). Unset = container default
# OMP_NUM_THREADS=1 (best throughput under concurrent requests on small boxes). Raise it
# on a multi-core host to lower single-request latency. Must be an integer when set.
#RMODHUB_TORCH_THREADS=2

# Allowed CORS origins: JSON list or comma-separated. Leave unset/empty to disable the
# CORS middleware (same-origin use only).
#RMODHUB_CORS_ORIGINS=["https://rmodhub.example.org"]

# ---------------------------------------------------------------------------
# Deployment (docker-compose.yml / docker-compose.prod.yml)
# ---------------------------------------------------------------------------

# Host port of the API container published by `docker compose up` (dev only; prod puts
# Caddy on 80/443 and removes the mapping). `make smoke` & co. read it from here too.
RMODHUB_PORT=8000

# Host port of the web UI (nginx: React app + reverse proxy to the API) published by
# `docker compose up`: open http://localhost:8080. Removed in prod as well; `make up`,
# `make web-smoke` and `make phase2-smoke` read it from here.
RMODHUB_WEB_PORT=8080

# Public hostname served by Caddy in production. DNS must point at this host so
# Let's Encrypt can issue a certificate. "localhost" = self-signed internal CA.
RMODHUB_DOMAIN=rmodhub.example.org

# Reverse proxies whose X-Forwarded-For / X-Forwarded-Proto the api believes (comma-
# separated IPs or CIDRs). Unset = the api container's own network, i.e. the compose
# network that `web` (nginx) and Caddy are on, detected at start-up, minus Docker's
# gateway address (where connections relayed to a published port come from). Set it
# only when the proxy sits outside the compose network -- a reverse proxy on the host
# itself reaches the published port from that gateway address (e.g. 172.20.0.1). Never
# "*": a client could then choose its own per-address quota key with its own header.
#RMODHUB_TRUSTED_PROXIES=172.20.0.1

# Outer body bound Caddy puts on the one-shot multipart route /api/jobs/signal (prod
# only; binary units). Keep it >= RMODHUB_MAX_POD5_GB + RMODHUB_MAX_BAM_GB +
# RMODHUB_MAX_REFERENCE_MB + ~80 MiB, or a request the api would accept gets a bare 413.
#RMODHUB_MULTIPART_MAX_SIZE=11GiB

# ---------------------------------------------------------------------------
# Nanopore signal branch (DirectRM jobs): `docker compose --profile phase2 up`
# ---------------------------------------------------------------------------
# The branch is ON exactly when the api sees a DATABASE_URL. docker-compose.yml builds
# DATABASE_URL and CELERY_BROKER_URL from POSTGRES_PASSWORD, and postgres/redis/worker
# live in the Compose profile "phase2": set the three lines below together (`make` adds
# the profile itself whenever POSTGRES_PASSWORD is set). A password without the profile
# leaves the api retrying a Postgres that never starts. Leave all three unset to run the
# sequence branch alone.

# Profile(s) Compose includes in every command (up, down, the prod override, ...).
#COMPOSE_PROFILES=phase2

# Password for the `rmodhub` Postgres role. docker-compose.yml splices it raw into
# DATABASE_URL, so it must not contain `@` (ends the credentials), `%` (percent-decoded
# by SQLAlchemy), `$` (interpolated by Compose) or whitespace; letters and digits are
# always safe: openssl rand -hex 24. REQUIRED for the signal branch; never keep "change-me".
#POSTGRES_PASSWORD=

# HMAC key that replaces client addresses in the jobs table (per-address quota; raw IPs
# are never stored). REQUIRED for the signal branch: the api container refuses to start
# it without one, or with the development default "rmodhub-dev", because a known key
# makes every stored address recoverable. Generate one with: openssl rand -hex 32
#RMODHUB_IP_HASH_SECRET=
# Local experiments only: run the signal branch with the development key anyway.
#RMODHUB_ALLOW_DEV_SECRET=1

# Running outside compose? Set the URLs directly instead (the RMODHUB_ prefix is
# optional for these two).
#DATABASE_URL=postgresql+psycopg://rmodhub:<password>@localhost:5432/rmodhub
#CELERY_BROKER_URL=redis://localhost:6379/0

# Shared volume with tus/ partial uploads and jobs/<job_id>/ (api and worker).
#RMODHUB_UPLOAD_DIR=/data/uploads

# Upload caps (binary units: 5 = 5 GiB). Raise RMODHUB_MULTIPART_MAX_SIZE (Caddy's outer
# bound on the one-shot multipart route, 11 GiB) with them; nginx/Caddy allow 64 MiB per
# tus chunk (the browser sends 16 MiB).
#RMODHUB_MAX_POD5_GB=5
#RMODHUB_MAX_BAM_GB=5
#RMODHUB_MAX_REFERENCE_MB=500
# Most data rows accepted in regions.csv.
#RMODHUB_MAX_REGIONS=10000
# Largest tus PATCH body the api accepts (MiB); keep <= the nginx/Caddy 64 MiB limits.
#RMODHUB_TUS_CHUNK_MB=64

# Fair-use quotas per client address: jobs in `running`, and jobs in `uploading`+`queued`.
#RMODHUB_MAX_RUNNING_PER_IP=1
#RMODHUB_MAX_QUEUED_PER_IP=3

# Hard cap on one job (Celery soft time limit, seconds; the hard limit is +300 s).
#RMODHUB_JOB_TIMEOUT_S=21600

# Data lifecycle. pod5 + BAM are deleted by the worker right after feature extraction;
# the cleanup loop (every RMODHUB_CLEANUP_INTERVAL_S in the api, or
# `python -m app.jobs.cleanup` from cron) removes the input/ of any job older than
# RMODHUB_INPUTS_MAX_AGE_H whose worker never got to it (a job still queued then is marked
# failed), expires unfinished uploads after RMODHUB_UPLOAD_TTL_H, removes results
# RMODHUB_RESULTS_RETENTION_DAYS after completion and purges the job row one more
# retention period later (GET /api/jobs/{id} answers 404 from then on).
#RMODHUB_RESULTS_RETENTION_DAYS=14
#RMODHUB_INPUTS_MAX_AGE_H=48
#RMODHUB_UPLOAD_TTL_H=48
#RMODHUB_CLEANUP_INTERVAL_S=3600

# OMP/MKL threads of the DirectRM child processes in the worker. docker-compose.yml passes
# 4; the image on its own defaults to 1. Reruns are byte-identical only at a fixed thread
# count: on the sample, 4 threads vs 1 keeps every count / coverage / rate but shifts the
# per-read probabilities by up to 6e-8 (within the golden test's 1e-6 tolerance). The golden
# fixture in worker/tests was made with 1 thread; set 1 to reproduce it byte for byte.
#RMODHUB_WORKER_THREADS=4

# Directory of the synthetic sample served by GET /api/samples/signal and run by "Load
# sample data" (POST /api/jobs/signal/sample). Default: app/samples/signal inside the
# package; the routes answer 404 when it is missing. Not forwarded by docker-compose.yml
# (the image ships the sample); for a deployment outside the image or a bind mount.
#RMODHUB_SAMPLE_DIR=/data/sample
